// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "diff_view_style": "split",
  "vim": {
    "use_smartcase_find": false
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "colorize_brackets": false,
  "toolbar": {
    "selections_menu": true,
    "agent_review": false,
    "breadcrumbs": true
  },
  "which_key": {
    "enabled": true
  },
  "helix_mode": false,
  "server_url": "https://zed.dev",
  "proxy": "",
  "cli_default_open_behavior": "existing_window",
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "buffer_font_family": "Fira Code",
  "icon_theme": {
    "mode": "dark",
    "light": "Bearded Icon Theme",
    "dark": "Bearded Icon Theme"
  },
  "disable_ai": true,
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
  },
  "vim_mode": true,
  // Auto-install marketplace extensions on startup
  "auto_install_extensions": {
    "bearded-icon-theme": true,
    "catppuccin-blur": true,
    "catppuccin-icons": true,
    "colored-zed-icons-theme": true,
    "html": true,
    "just": true,
    "kanagawa-themes": true,
    "material-icon-theme": true,
    "mermaid": true,
    "poimandres": true,
    "ruby": true,
    "sql": true,
    "terraform": true,
    "tokyo-night": true,
    "toml": true,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    // Cursor Dark: dev extension https://github.com/nexmoe/cursor-themes-for-zed
    //   cloned at ~/.local/share/zed-extensions/cursor-themes-for-zed
    //   installed via: cmd-shift-p → "zed: install dev extension"
    // Catppuccin Blur: macOS window blur variants
    //   bases: Espresso (near-black) / Mocha (dark navy) etc.
    //   suffixes: "[Light]" (less blur) / "[Heavy]" (more blur)
    "dark": "Catppuccin Mocha (Blur)"
  },
  "buffer_font_size": 14,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "off",
  "formatter": "language_server",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop"]
    }
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayVariableTypeHintsWhenTypeMatchesName": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true
        }
      }
    }
  },
  "terminal": {
    "copy_on_select": true
  },
  "project_panel": {
    "dock": "right"
  },
  "file_scan_exclusions": [
     "**/.git",
     "**/.svn",
     "**/.hg",
     "**/.jj",
     "**/CVS",
     "**/.DS_Store",
     "**/Thumbs.db",
     "**/.classpath",
     "**/.settings",
     "**/.fvm",
     ".claude/worktrees/**"
   ]
}
