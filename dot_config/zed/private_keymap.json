[
  // cmd-shift-g: git panel をトグル (デフォルトの search::SelectPreviousMatch を上書き)
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      // open commit modal from anywhere (also bound to "space g c" in vim normal mode)
      "cmd-alt-c": "git::ExpandCommitEditor"
    }
  },

  // nvim-style ctrl-hjkl window navigation from docked panels
  // (panels behave like nvim windows; Terminal excluded to keep ctrl-l = clear)
  {
    "context": "Dock && !Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-m": [
        "action::Sequence",
        ["markdown::OpenPreviewToTheSide", "workspace::ActivatePaneRight"]
      ]
    }
  },

  // insert mode: jj → ESC
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore"
    }
  },

  // normal mode: leader (space) + Ctrl bindings
  {
    "context": "vim_mode == normal && vim_operator == none && !VimWaiting",
    "bindings": {
      // window navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      // file ops
      "ctrl-s": "workspace::Save",

      // buffer (tab) nav
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",

      // git hunk nav
      "] g": "editor::GoToHunk",
      "[ g": "editor::GoToPreviousHunk",

      // splits (local: | vsplit / \ hsplit)
      "|": "pane::SplitRight",
      "\\": "pane::SplitDown",

      // line start / end (local: S-h / S-l)
      "shift-h": "vim::FirstNonWhitespace",
      "shift-l": "vim::EndOfLine",

      // folds (Vim/NvChad-style z* bindings)
      "z a": "editor::ToggleFold",
      "z c": "editor::Fold",
      "z o": "editor::UnfoldLines",
      "z shift-a": "editor::ToggleFoldRecursive",
      "z shift-o": "editor::UnfoldRecursive",
      "z shift-m": "editor::FoldAll",
      "z shift-r": "editor::UnfoldAll",

      // project panel (NvimTree)
      "ctrl-n": "project_panel::ToggleFocus",

      // leader (space) bindings
      // telescope-ish finders
      "space f f": "file_finder::Toggle",
      "space f w": "workspace::NewSearch",
      "space f b": "tab_switcher::Toggle",
      "space f z": "buffer_search::Deploy",
      "space f m": "editor::Format",
      "space f p": ["projects::OpenRecent", { "create_new_window": false }],

      // comment
      "space /": "editor::ToggleComments",

      // LSP
      "space c a": "editor::ToggleCodeActions",
      "space d s": "diagnostics::Deploy",

      // project / buffers
      "space e": "project_panel::ToggleFocus",
      "space x": "pane::CloseActiveItem",
      "space q": "pane::CloseActiveItem",
      "space shift-q": "workspace::CloseWindow",
      "space b": "workspace::NewFile",

      // toggles
      "space n": "editor::ToggleLineNumbers",
      // zen mode (like nvim's zen-mode)
      "space z z": "workspace::ToggleCenteredLayout",

      // bookmarks (built-in)
      "space m m": "editor::ToggleBookmark",
      "space m n": "editor::GoToNextBookmark",
      "space m p": "editor::GoToPreviousBookmark",
      "space m l": "editor::ViewBookmarks",
      "space m c": "workspace::ClearBookmarks",

      // git
      "space g h": "git::FileHistory",
      "space g b": "git::Blame",
      "space g g": "git_panel::ToggleFocus",
      "space g c": "git::ExpandCommitEditor",
      "space g d": "git::Diff",
      "space g m": "git::OpenModifiedFiles"
    }
  },

  // visual mode: leader (space) bindings
  {
    "context": "vim_mode == visual",
    "bindings": {
      "space /": "editor::ToggleComments",
      "space f m": "editor::Format"
    }
  }
]
