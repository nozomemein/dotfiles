theme = Aura
font-family = Fira Code
font-family = BIZ UDGothic
font-style = Regular
font-size = 14
font-thicken = true
font-synthetic-style = no-italic,no-bold-italic
font-feature = -dlig
background-opacity = 0.8

# 左 Option キーを Alt として送る (Helix の Alt-s 等を有効化)
# 右 Option は macOS 本来の特殊文字入力に残す
macos-option-as-alt = left

