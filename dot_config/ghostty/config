theme = Aura
font-family = Fira Code
font-family = BIZ UDGothic
font-style = Regular
font-size = 14
font-thicken = true
font-synthetic-style = no-italic,no-bold-italic
font-feature = -dlig
background-opacity = 0.8

# Send the left Option key as Alt (so Helix's Alt-s etc. work).
# Leave the right Option for macOS's native special-character input.
macos-option-as-alt = left

