# Shared aliases (managed by chezmoi)
# Local config: user, signingkey, etc. (not managed by chezmoi)
[include]
	path = ~/.config/git/alias.conf
	path = ~/.config/git/delta.conf
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[branch]
	# newest branches first in `git branch`
	sort = -committerdate

[fetch]
	# drop remote-tracking refs for branches deleted on the remote
	prune = true

[pull]
	rebase = true

[push]
	# first push of a new branch sets upstream without -u
	autoSetupRemote = true

[rerere]
	# remember conflict resolutions and replay them on the next rebase
	enabled = true

[rebase]
	autoSquash = true
	autoStash = true

[commit]
	verbose = true

# GitHub auth via gh (what `gh auth setup-git` writes). The empty helper line
# resets helpers inherited from the system config so gh is the only one used.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
